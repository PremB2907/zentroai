# .env.example
# Copy this file to .env and fill in any keys you need.
# .env is listed in .gitignore and must never be committed.
# -----------------------------------------------------------------

# --- Primary provider (local, no API key required) ---------------
# Ollama must be running: https://ollama.com
# Pull a model first: ollama pull gemma2:2b
LLM_PROVIDER=ollama

# Ollama server URL (change if Ollama is on a different host/port)
OLLAMA_BASE_URL=http://localhost:11434

# Model tag to use.  Must already be downloaded via `ollama pull`.
# Default (if blank): gemma2:2b  (verified installed, Oct 2026)
# Other options: llama3.2:3b | phi3:mini | mistral:7b
# List installed models: ollama list
OLLAMA_MODEL=gemma2:2b

# --- Optional cloud providers ------------------------------------
# Set LLM_PROVIDER to one of these values to override Ollama:
#   groq | nvidia | gemini
# Leave API keys blank if you are using Ollama only.

# Groq (free tier: ~14 000 req/day)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# NVIDIA NIM (requires account at build.nvidia.com)
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.1-70b-instruct

# Gemini (Google AI Studio, free tier: 1 500 req/day)
GEMINI_API_KEY=
# DO NOT use gemini-2.0-flash (no suffix) — that alias is deprecated (HTTP 404).
GEMINI_MODEL=gemini-2.0-flash-001

# --- Agent / CLI settings ----------------------------------------
# Agent mode used by src/cli.py when --mode flag is not passed.
# Valid values: baseline | rag | full
AGENT_MODE=full
